generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  name              String?
  password          String
  role              Role          @default(Athlete)
  verified          Boolean       @default(false)
  verificationToken String?
  isOnboarded       Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  athlete           Athlete?
  coach             Coach?
  doctor            Doctor?
  receivedMessages  Message[]     @relation("MessageReceiver")
  sentMessages      Message[]     @relation("MessageSender")
  organization      Organization?
  notifications      Notifications[]
}

model Athlete {
  id           String        @id @default(uuid())
  userId       String        @unique
  dateOfBirth  DateTime
  sport        String
  gender       Gender
  height       String
  weight       Float
  locationId   String?       @unique
  image        String?
  account      Account[]
  achievements Achievement[]
  appointments Appointment[]
  location     Location?     @relation(fields: [locationId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  illnesses    Illness[]
  injuries     Injry[]
  transactions Transaction[]
}

model Coach {
  id              String        @id @default(uuid())
  userId          String        @unique
  specialization  String
  experienceYears Int
  gender          Gender
  sport           String
  locationId      String?       @unique
  availabilityId  String?       @unique
  image           String?
  availability    Availability? @relation(fields: [availabilityId], references: [id])
  location        Location?     @relation(fields: [locationId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
}

model Doctor {
  id              String        @id @default(uuid())
  userId          String        @unique
  specialization  String
  experienceYears Int
  college         String
  year            Int
  degree          String
  gender          Gender
  locationId      String?       @unique
  availabilityId  String?       @unique
  image           String?
  appointments    Appointment[]
  availability    Availability? @relation(fields: [availabilityId], references: [id])
  location        Location?     @relation(fields: [locationId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
}

model Organization {
  id          String    @id @default(uuid())
  userId      String    @unique
  description String
  website     String
  phone       String
  locationId  String?   @unique
  image       String?
  location    Location? @relation(fields: [locationId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model Location {
  id           String        @id @default(uuid())
  city         String?
  state        String
  country      String
  pincode      String?
  athlete      Athlete?
  coach        Coach?
  doctor       Doctor?
  organization Organization?
}

model Availability {
  id        String   @id @default(uuid())
  day       Int
  startTime DateTime
  endTime   DateTime
  coach     Coach?
  doctor    Doctor?
}

model Achievement {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id])
}

model Injry {
  id              String   @id @default(uuid())
  type            String
  bodyPart        String
  tissueType      String
  injuryName      String
  severity        String
  sport           String
  activity        String
  mechanism       String
  isRecovered     Boolean
  date            DateTime
  trainingStatus  String
  personalProgram String
  comments        String
  athleteId       String
  athlete         Athlete  @relation(fields: [athleteId], references: [id])
}

model Illness {
  id              String   @id @default(uuid())
  category        String
  illnessName     String
  severity        String
  isRecovered     Boolean
  date            DateTime
  trainingStatus  String
  personalProgram String
  comments        String
  athleteId       String
  athlete         Athlete  @relation(fields: [athleteId], references: [id])
}

model Appointment {
  id            String   @id @default(uuid())
  date          DateTime
  type          String
  startTime     DateTime
  endTime       DateTime
  note          String
  status        String?
  bodyPart      String?
  tissueType    String?
  injuryName    String?
  category      String?
  illnessName     String?
  athleteId     String
  doctorId      String
  athlete       Athlete  @relation(fields: [athleteId], references: [id])
  doctor        Doctor   @relation(fields: [doctorId], references: [id])
  notes         Notes[]
  notifications Notifications?
}

model Account {
  id            String        @id @default(uuid())
  athleteId     String
  name          String
  accountNumber String
  type          String
  balance       Int
  isDefault     Boolean
  status        String
  athlete       Athlete       @relation(fields: [athleteId], references: [id])
  transactions  Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  type        String
  amount      String
  date        DateTime
  category    String
  status      String
  accountId   String
  athleteId   String
  description String
  account     Account  @relation(fields: [accountId], references: [id])
  athlete     Athlete  @relation(fields: [athleteId], references: [id])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  image      String?
  timestamp  DateTime @default(now())
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
}

enum Role {
  Athlete
  Coach
  Doctor
  Organization
}

enum Gender {
  Male
  Female
}
model Notes{
  id              String  @id @default(uuid())
  task            String
  subjective      String
  objective       String
  assessment      String
  plan            String
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  notificationId  String? @unique
  notification    Notifications? @relation(fields: [notificationId], references: [id])
}

model Notifications{
  id              String   @id @default(uuid()) 
  title           String
  message         String
  type            type
  isRead          Boolean  @default(false)
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
  note            Notes?
  appointmentId   String?@unique
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
}
enum type{
  Appointment
  Message
  Transaction
  Other
}
